// secrets.h.example — copy to firmware/src/secrets.h and fill in.
// secrets.h is git-ignored; this template is the only version committed.
//
// In main.cpp, replace the hardcoded credential lines with:
//
//     #include "secrets.h"
//     const char* ssid     = WIFI_SSID;
//     const char* password = WIFI_PASSWORD;
//
#pragma once

#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"

// Optional: mDNS hostname the board announces itself under.
// The dashboard's default AO_ARM_HOST is "ao-arm.local", so keeping this
// as "ao-arm" means you never have to chase a DHCP address again.
#define ARM_HOSTNAME  "ao-arm"
